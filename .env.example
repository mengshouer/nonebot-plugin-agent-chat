# 查看每个 AGENT_CHAT_* 配置项的说明：
#   nonebot-agent-chat --config-explain <KEY>（也可用 --config-list / :config <KEY>）
# 示例 Profile 引用的服务商凭据
# 也可在 Profile 中直接填写 "api_key" / "exa_api_key"，其优先级高于以下环境变量
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
EXA_API_KEY=replace-with-exa-key

# Profile 与运行时数据目录（相对于宿主 Bot 的工作目录）
AGENT_CHAT_DEFAULT_PROFILE=openai-chat
AGENT_CHAT_PROFILE_DIR=data/agent_chat/profiles
# Profile 和本文件仅在启动或显式重载时读取，不会后台轮询。
# /agentctl reload 执行时重载；nonebot-agent-chat --reload 或 --config-set 编辑
# 会请求 Bot 在下一条消息到来时重载。
# 可选的全局默认系统提示词：Profile 的 system_prompt 和 system_prompt_file 均未设置时使用。
# 路径相对于 <数据目录>/prompts。
AGENT_CHAT_DEFAULT_SYSTEM_PROMPT_FILE=default.md
AGENT_CHAT_DATA_DIR=data/agent_chat
AGENT_CHAT_DEBUG_DATA_DIR=data/agent_chat/debug
AGENT_CHAT_CLEANUP_INTERVAL_SECONDS=3600

# 默认拒绝普通用户；NoneBot 超级用户始终允许。
# 白名单格式为 <平台标识>:<群号或用户ID>，平台标识如 QQClient、Telegram，
# 区分大小写，不是适配器包名。
# 在本地查询平台标识：nonebot-agent-chat --platform-list
# <平台标识>:* 放行该平台全部会话；只写裸 ID 会导致启动失败。
#   AGENT_CHAT_ALLOWED_GROUPS=["QQClient:123456789", "Telegram:-1001234567890"]
#   AGENT_CHAT_ALLOWED_USERS=["QQClient:12345", "Telegram:67890"]
AGENT_CHAT_ALLOWED_GROUPS=[]
AGENT_CHAT_ALLOWED_USERS=[]
# 提问触发词，可配置多个；消息中包含任意一个即可触发。
AGENT_CHAT_TRIGGERS=["/llm"]
AGENT_CHAT_ENABLE_AT=false
AGENT_CHAT_ENABLE_PRIVATE_AUTO_REPLY=false

# 可选的持久对话 Room，仅超级用户可用
AGENT_CHAT_ROOM_ENABLED=false

# 请求限制；每日请求配额设为 0 表示不限
AGENT_CHAT_GLOBAL_CONCURRENCY=4
AGENT_CHAT_USER_COOLDOWN_SECONDS=5
AGENT_CHAT_DAILY_REQUEST_LIMIT=0
AGENT_CHAT_MAX_MODEL_TURNS=6
AGENT_CHAT_MAX_LOCAL_TOOL_CALLS=8
# 单次请求的搜索总次数上限，包含各轮调用和重试
AGENT_CHAT_MAX_SEARCHES=10
AGENT_CHAT_TOOL_TIMEOUT_SECONDS=30
AGENT_CHAT_RUN_TIMEOUT_SECONDS=180

# 长回答会分条发送。平台拒绝长消息时可降低分条长度；限流时可增加发送间隔。
# 分条长度设为 0 表示插件不主动限制长度。
AGENT_CHAT_MESSAGE_CHUNK_CHARS=1000
# 可选的按平台分条长度覆盖，键为区分大小写的平台标识。
# 0 表示不使用插件自身的长度限制：已知平台上限时按其限制分条
# （Telegram 为 4096 个 UTF-16 编码单元）；未知上限时先发送完整回答，
# 被拒绝后再自适应拆分。下面一行就是内置默认值，
# 只有需要显式设置时才取消注释：
# AGENT_CHAT_MESSAGE_CHUNK_CHARS_BY_PLATFORM={"Telegram": 0}
AGENT_CHAT_MESSAGE_SEND_DELAY_SECONDS=1.0

# 图片回复模式：off（关闭）/ auto（自动）/ always（始终）。需从源码安装 render-image
# 扩展依赖及 Playwright Chromium，步骤见 README.md。
AGENT_CHAT_IMAGE_REPLY_MODE=off
# 可选的按平台图片模式覆盖，键为区分大小写的平台标识；
# 优先于 Profile 的 image_reply_mode 和全局模式。
# Telegram 原生支持 Markdown，因此下面一行就是内置默认值；
# 若要启用图片回复，取消注释并改为 {"Telegram": "auto"}：
# AGENT_CHAT_IMAGE_REPLY_MODE_BY_PLATFORM={"Telegram": "off"}
# auto 模式：回答超过此长度，或包含表格、较长的围栏代码块时转为图片
AGENT_CHAT_IMAGE_REPLY_MIN_CHARS=1000
# 每页图片的最大像素高度；超出时分为多页
AGENT_CHAT_IMAGE_REPLY_MAX_HEIGHT=8000
# 每页图片的渲染超时（秒）
AGENT_CHAT_IMAGE_REPLY_TIMEOUT_SECONDS=20

# 文字回答是否附加“来源：”链接页脚（true）；关闭时仅发送回答正文，
# 不影响正文中的 Markdown 链接。按平台设置优先于 Profile 字段，
# Profile 字段优先于这些全局设置。
AGENT_CHAT_SHOW_SOURCES_TEXT=true
# AGENT_CHAT_SHOW_SOURCES_TEXT_BY_PLATFORM={"QQClient": false}
# 图片回答的对应开关：关闭时移除整个渲染页脚，
# 包括正文内嵌链接的原始 URL。
AGENT_CHAT_SHOW_SOURCES_IMAGE=true
# AGENT_CHAT_SHOW_SOURCES_IMAGE_BY_PLATFORM={"QQClient": false}
